  "askUserQuestionTimeout": "10m",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(find *)",
            "shell": "powershell",
            "command": "pwsh -NoProfile -Command \"& (Join-Path (git rev-parse --show-toplevel) '.claude/scripts/hooks/deny-find-jar.ps1')\""
          },
          {
            "type": "command",
            "if": "Bash(for *)",
            "shell": "powershell",
            "command": "pwsh -NoProfile -Command \"& (Join-Path (git rev-parse --show-toplevel) '.claude/scripts/hooks/deny-loop-around-script.ps1')\""
          },
          {
            "type": "command",
            "shell": "powershell",
            "command": "pwsh -NoProfile -Command \"& (Join-Path (git rev-parse --show-toplevel) '.claude/scripts/hooks/deny-chained-command.ps1')\""
          },
          {
            "type": "command",
            "if": "Bash(find *)",
            "shell": "powershell",
            "command": "pwsh -NoProfile -Command \"& (Join-Path (git rev-parse --show-toplevel) '.claude/scripts/hooks/deny-find-locator.ps1')\""
          },
          {
            "type": "command",
            "if": "Bash(cat *)",
            "shell": "powershell",
            "command": "pwsh -NoProfile -Command \"& (Join-Path (git rev-parse --show-toplevel) '.claude/scripts/hooks/deny-cat-read.ps1')\""
          },
          {
            "type": "command",
            "if": "Bash(awk *)",
            "shell": "powershell",
            "command": "pwsh -NoProfile -Command \"& (Join-Path (git rev-parse --show-toplevel) '.claude/scripts/hooks/deny-awk-range.ps1')\""
          },
          {
            "type": "command",
            "shell": "powershell",
            "command": "pwsh -NoProfile -Command \"& (Join-Path (git rev-parse --show-toplevel) '.claude/scripts/hooks/deny-evidence-write.ps1')\""
          },
          {
            "type": "command",
            "if": "Bash(grep *)",
            "shell": "powershell",
            "command": "pwsh -NoProfile -Command \"& (Join-Path (git rev-parse --show-toplevel) '.claude/scripts/hooks/deny-grep-search.ps1')\""
          },
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "shell": "powershell",
            "command": "pwsh -NoProfile -Command \"& (Join-Path (git rev-parse --show-toplevel) '.claude/scripts/hooks/deny-pathspec-commit-with-untracked.ps1')\""
          },
          {
            "type": "command",
            "shell": "powershell",
            "command": "pwsh -NoProfile -Command \"& (Join-Path (git rev-parse --show-toplevel) '.claude/scripts/hooks/deny-unless-whitelisted.ps1')\""
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "pwsh -NoProfile -Command \"& (Join-Path (git rev-parse --show-toplevel) '.claude/scripts/hooks/deny-unless-whitelisted.ps1')\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "pwsh -NoProfile -Command \"& (Join-Path (git rev-parse --show-toplevel) '.claude/scripts/hooks/deny-repo-token-in-plugin.ps1')\""
          }
        ]
