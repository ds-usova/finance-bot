# PostgreSQL Configuration — the bootstrap superuser and its default database, used by nothing else
FINANCE_BOT_DB_USER=example_finance_bot_user
FINANCE_BOT_DB_PASSWORD=example_finance_bot_password
FINANCE_BOT_DB=example_finance_bot_db

# The ledger's own role and database
FINANCE_BOT_LEDGER_DB_USER=example_finance_bot_ledger_user
FINANCE_BOT_LEDGER_DB_PASSWORD=example_finance_bot_ledger_password
FINANCE_BOT_LEDGER_DB=example_finance_bot_ledger_db

# The connector's own role and database
FINANCE_BOT_AI_DB_USER=example_finance_bot_ai_user
FINANCE_BOT_AI_DB_PASSWORD=example_finance_bot_ai_password
FINANCE_BOT_AI_DB=example_finance_bot_ai_db

# Prefixed so a global TELEGRAM_BOT_TOKEN or OPENAI_API_KEY in the shell cannot win over this file
FINANCE_BOT_TELEGRAM_BOT_TOKEN=example_telegram_bot_token
FINANCE_BOT_OPENAI_API_KEY=example_openai_api_key

# The bot the web app's Telegram Login Widget signs users in for, without the leading @
FINANCE_BOT_TELEGRAM_BOT_USERNAME=example_finance_bot

# Compose defaults this to true, since a Telegram sign-in needs an HTTPS tunnel in front of the
# web app. Set it to false only to reach the web app over plain http from another device.
#FINANCE_BOT_WEB_SESSION_COOKIE_SECURE=true

# The header value POST /actuator/cdc demands, on the management port compose does not publish
FINANCE_BOT_CDC_RECOVERY_SECRET=example_cdc_recovery_secret